{
  "id": "sap2000-mcp",
  "name": "SAP2000 Connector",
  "version": "1.0.0",
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "python",
  "entry": "run_server.py",
  "min_app_version": "0.4.0",
  "entitlement_tier": "pro",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "platform_requirements": {
    "windows": ["Windows 10/11", "SAP2000 installed (COM automation)"],
    "com": ["SAP2000 must be running or launchable for connect_sap2000; MCP server starts fine without it"]
  }
}
